rules_version = '2';

// Règles de sécurité de la base en ligne (à coller dans la console Firebase → Firestore → Règles).
// - users/{uid}/… : chacun ne lit et n'écrit que sa propre progression ;
// - challenges/{id} : un défi s'ouvre avec son lien (son identifiant, difficile à deviner) ;
//   chaque joueur n'y écrit que sa propre case, une seule fois ; le créateur peut y inviter des amis.
// Tout le reste est fermé.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    match /users/{uid}/{document=**} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }

    match /challenges/{id} {
      allow get: if signedIn();
      // Lister : seulement les défis où je figure (requête « participants contient moi »).
      allow list: if signedIn() && request.auth.uid in resource.data.participants;

      allow create: if signedIn()
        && request.resource.data.creator == request.auth.uid
        && request.auth.uid in request.resource.data.participants
        && request.resource.data.results.keys().hasOnly([request.auth.uid])
        && request.resource.data.names.keys().hasOnly([request.auth.uid]);

      allow update: if signedIn() && (creatorInvites() || answers());

      // Le créateur ajoute des amis à qui l'envoyer (sans rien retirer).
      function creatorInvites() {
        return resource.data.creator == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['participants', 'invited'])
          && request.resource.data.participants.hasAll(resource.data.participants)
          && request.resource.data.invited.hasAll(resource.data.invited);
      }

      // Un joueur ajoute son résultat (une seule fois), son prénom et sa participation.
      function answers() {
        let uid = request.auth.uid;
        return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['participants', 'names', 'results'])
          && !(uid in resource.data.results)
          && request.resource.data.results.diff(resource.data.results).affectedKeys().hasOnly([uid])
          && request.resource.data.names.diff(resource.data.names).affectedKeys().hasOnly([uid])
          && request.resource.data.participants.hasAll(resource.data.participants)
          && request.resource.data.participants.toSet().difference(resource.data.participants.toSet()).hasOnly([uid]);
      }
    }
  }
}
