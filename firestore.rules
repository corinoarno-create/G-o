rules_version = '2';

// Règles de sécurité de la base en ligne (à coller dans la console Firebase → Firestore → Règles).
// Chacun ne lit et n'écrit que sa propre progression : users/{son identifiant}/…
// Tout le reste est fermé. (Les défis entre amis ajouteront leurs propres règles.)
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
