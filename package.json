{
  "name": "geo",
  "private": true,
  "version": "0.0.0",
  "description": "Mon app perso d'apprentissage de la géographie, pilotée par la répétition espacée.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
